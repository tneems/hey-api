{
  "openapi": "3.0.0",
  "info": {
    "title": "OpenAPI 3.0.0 JSON-encoded parameter example",
    "version": "1"
  },
  "paths": {
    "/foo": {
      "get": {
        "operationId": "getFoo",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "node",
            "in": "query",
            "required": false,
            "description": "Identifies a node by exactly one of its identifiers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeResolver"
                }
              }
            }
          },
          {
            "name": "ids",
            "in": "query",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "responses": {
          "default": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NodeResolver": {
        "type": "object",
        "description": "Identifies a node by exactly one of node_id, user_id, or email",
        "minProperties": 1,
        "maxProperties": 1,
        "properties": {
          "node_id": {
            "type": "string",
            "format": "uuid"
          },
          "user_id": {
            "type": "integer"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      }
    }
  }
}
